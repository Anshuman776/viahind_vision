# Backend the Next.js server proxies /api/v1 to (server-side; read at build/start time)
BACKEND_URL=http://127.0.0.1:8000

# Where browsers open live-video WebSockets. Leave unset to use <page hostname>:8000.
# Behind a reverse proxy on one HTTPS origin use e.g. wss://surveillance.example.com
# NEXT_PUBLIC_WS_URL=

# Comma-separated hostnames allowed to load the dev server (e.g. this PC's LAN IP for a phone)
# NEXT_DEV_ALLOWED_ORIGINS=192.168.1.5
