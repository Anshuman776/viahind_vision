# ==============================================================================
# VIAHIND Vision Backend Environment Template (.env.example)
# Copy this file to .env and populate with production credentials.
# ==============================================================================

# Core Application Settings
APP_NAME="VIAHIND Vision Security Analytics API"
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication
SECRET_KEY=change-this-in-production-use-strong-random-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/viahind_vision

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Edge Agent & RTSP Video Stream Ingestion
RTSP_BROKER_URL=rtsp://localhost:8554/live
MAX_SIMULTANEOUS_STREAMS=16
EVIDENCE_STORAGE_DIR=./storage/evidence

# AI Fight Classifier Model Parameters
FIGHT_DETECTOR_MODEL=VIAHIND-FightClassifier-MobileNetV3
FIGHT_DETECTOR_VERSION=v2.4.1-edge
FIGHT_CONFIDENCE_THRESHOLD=0.75
ENABLE_SYNTHETIC_MOCK_FALLBACK=True

# Facility Metadata
ACTIVE_FACILITY_ID=FAC-PG-BLOCK-A
ACTIVE_FACILITY_NAME="PG Block A - Multi-Floor Residence"
FLOORS_COUNT=5
