# ==============================================================================
# VIAHIND Vision Backend Environment Template (.env.example)
# Copy this file to .env and fill in real values. Never commit .env.
# ==============================================================================

# Core Application Settings
APP_NAME="VIAHIND Vision Security Analytics API"
# development | demo | production   (demo uses DEMO_DATABASE_URL with synthetic records)
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# Security & Authentication
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-in-production-use-strong-random-hex
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
# True when served over HTTPS (required in production)
COOKIE_SECURE=False
# Optional: create the first admin on startup when no users exist (remove afterwards).
# Alternatively run:  python manage.py create-user <name> --role admin
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Database. SQLite works out of the box; for PostgreSQL install psycopg[binary] and use
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/viahind_vision
DATABASE_URL=sqlite:///./storage/viahind.db
DEMO_DATABASE_URL=sqlite:///./storage/viahind_demo.db

# Redis Cache & Message Broker (reserved; not required)
REDIS_URL=redis://localhost:6379/0

# Cross-Origin Resource Sharing. The frontend proxies /api through Next.js, so this only
# matters for other trusted origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
STORAGE_DIR=./storage
SNAPSHOT_DIR=./storage/snapshots
# Pre-recorded clips usable as "Test clip" camera sources (development only)
TEST_VIDEO_DIR=./storage/test_videos
ALLOW_FILE_SOURCES=True
MIN_FREE_DISK_MB=500

# Network camera credentials can stay out of the database entirely: set e.g.
# CAMERA_GATE_URL=rtsp://user:password@192.168.1.20:554/stream1
# and enter  env:CAMERA_GATE_URL  as the camera source in Settings.

# Person detection (YOLO + ByteTrack). Point at an existing local checkpoint, e.g. the
# yolo11n.pt used by viahind-person-counter. Weights are never downloaded automatically.
PERSON_MODEL_PATH=
PERSON_TRACKER_CONFIG=bytetrack.yaml
DETECTION_MAX_FPS=8
DETECTION_DEVICE=cpu
VIEWER_MAX_FPS=8
CAMERA_STALE_SECONDS=5

# Edge Agent & RTSP Video Stream Ingestion (legacy settings)
RTSP_BROKER_URL=rtsp://localhost:8554/live
MAX_SIMULTANEOUS_STREAMS=16
EVIDENCE_STORAGE_DIR=./storage/evidence

# Existing anomaly (fight) classifier: edge-agent/fight_detector.py via vision/anomaly.py
ANOMALY_DETECTION_ENABLED=False
ANOMALY_SAMPLE_EVERY_N_FRAMES=3
ANOMALY_CLIP_LENGTH=16
FIGHT_DETECTOR_MODEL=VIAHIND-FightClassifier-MobileNetV3
FIGHT_DETECTOR_VERSION=v2.4.1-edge
FIGHT_CONFIDENCE_THRESHOLD=0.75
ENABLE_SYNTHETIC_MOCK_FALLBACK=True

# Facility Metadata (initial values for Settings)
ACTIVE_FACILITY_ID=FAC-PG-BLOCK-A
ACTIVE_FACILITY_NAME="PG Block A - Multi-Floor Residence"
SITE_TIMEZONE=Asia/Kolkata
FLOORS_COUNT=5
