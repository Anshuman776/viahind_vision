# Copy to ./.env (next to docker-compose.yml). Docker Compose reads it for the values below.
# Never commit the real file.

# Database password (any long random string, e.g. from: openssl rand -base64 32)
POSTGRES_PASSWORD=

# Public address of the website.
#   Public IP / port forwarding:  SITE_ADDRESS=pg.example.com   (DNS A record -> this machine)
#   Cloudflare Tunnel:            SITE_ADDRESS=:80              (and set TUNNEL_TOKEN below)
SITE_ADDRESS=
# Email for Let's Encrypt certificate notices (public IP mode).
ACME_EMAIL=

# Cloudflare Tunnel token (only with --profile tunnel).
TUNNEL_TOKEN=

# Model files inside ./models (person detector) and ./models/video (fight classifier, with its .json).
PERSON_MODEL_FILE=yolo11n.pt
FIGHT_MODEL_FILE=fight_classifier_20261016194927.pt
